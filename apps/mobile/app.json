{
  "expo": {
    "name": "Ummah Library",
    "slug": "ummah-library",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ummahlibrary",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "backgroundColor": "#0b0f0e",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0f0e"
    },
    "android": {
      "package": "org.ummahlibrary.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0f0e"
      },
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "org.ummahlibrary.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-audio",
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Ummah Library to use your location to calculate prayer times and find the qibla direction."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "ece93f61-b220-47ff-ab00-1717a57ca628"
      }
    },
    "owner": "rashidmahmood"
  }
}
